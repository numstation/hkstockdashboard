# Copy to .env for local overrides (never commit .env)

# Optional — backtest_options.py fallback when yfinance fails
# ALPHA_VANTAGE_API_KEY=

# GitHub Actions / local deploy (see AUTO_UPDATE_SETUP.md)
# CLOUDFLARE_API_TOKEN=
# DASHBOARD_GITHUB_PAT=
# REFRESH_PUBLIC_KEY=

# Optional
# DASHBOARD_BASE_URL=https://hkstockdashboard.chrislau.workers.dev
# BACKTEST_SYMBOL=9988.HK
# SCAN_VALIDATE_MIN_OK=50

# HK Stock Hunter Pro — Railway Flask API base URL (Cloudflare Worker secret, not .env)
# Set on Worker: wrangler secret put ANALYSIS_API_URL
# ANALYSIS_API_URL=https://your-app.up.railway.app
